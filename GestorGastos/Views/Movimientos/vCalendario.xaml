<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestorGastos.ViewModels"
             xmlns:m="clr-namespace:GestorGastos.Models"
             x:Class="GestorGastos.Views.vCalendario"
             x:DataType="vm:CalendarioViewModel"
             Title="{Binding Titulo}">

    <!-- Sin ScrollView externo: solo la lista del día se desplaza (más rápido en Android) -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Padding="14,8,14,0">

        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Text="‹" Style="{StaticResource BotonCircular}" Command="{Binding MesAnteriorCommand}" />
            <Label Grid.Column="1" Text="{Binding MesTexto}" Style="{StaticResource Subtitulo}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="›" Style="{StaticResource BotonCircular}" Command="{Binding MesSiguienteCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="8">
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                    <Label Grid.Column="0" Text="L" Style="{StaticResource Etiqueta}" HorizontalOptions="Center" />
                    <Label Grid.Column="1" Text="M" Style="{StaticResource Etiqueta}" HorizontalOptions="Center" />
                    <Label Grid.Column="2" Text="M" Style="{StaticResource Etiqueta}" HorizontalOptions="Center" />
                    <Label Grid.Column="3" Text="J" Style="{StaticResource Etiqueta}" HorizontalOptions="Center" />
                    <Label Grid.Column="4" Text="V" Style="{StaticResource Etiqueta}" HorizontalOptions="Center" />
                    <Label Grid.Column="5" Text="S" Style="{StaticResource Etiqueta}" HorizontalOptions="Center" />
                    <Label Grid.Column="6" Text="D" Style="{StaticResource Etiqueta}" HorizontalOptions="Center" />
                </Grid>

                <!-- Las 42 celdas se crean una sola vez en vCalendario.xaml.cs y luego solo se actualizan -->
                <Grid x:Name="GridDias"
                      RowDefinitions="44,44,44,44,44,44"
                      ColumnDefinitions="*,*,*,*,*,*,*" />

                <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Label Text="● Ingresos" TextColor="{StaticResource Ingreso}" FontSize="12" />
                    <Label Text="● Gastos" TextColor="{StaticResource Gasto}" FontSize="12" />
                    <Label Text="● Pagos" TextColor="{StaticResource Advertencia}" FontSize="12" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="2" Text="{Binding DiaTexto}" Style="{StaticResource Subtitulo}" />

        <CollectionView Grid.Row="3" x:Name="ListaDia"
                        ItemsSource="{Binding MovimientosDia}"
                        SelectionMode="Single"
                        SelectionChanged="ListaDia_SelectionChanged">
            <CollectionView.Header>
                <Border Style="{StaticResource Tarjeta}" Padding="14,6" Margin="0,0,0,10">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PagosDia}">
                    <BindableLayout.EmptyView>
                        <Label Text="Sin pagos programados." Style="{StaticResource TextoSecundario}" Margin="0,8" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:PagoProximoDetalle">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                <Border Style="{StaticResource IconoCirculo}" BackgroundColor="{StaticResource AdvertenciaSuave}">
                                    <Label Text="{Binding Icono}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                    <Label Text="Pago pendiente" Style="{StaticResource TextoSecundario}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding MontoTexto}" FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource Advertencia}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                </Border>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="Sin movimientos este día." Style="{StaticResource TextoSecundario}" Margin="4,8" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:TransaccionDetalle">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                <Border Style="{StaticResource IconoCirculo}" BackgroundColor="{Binding ColorFondoIcono, Converter={StaticResource TextoAColor}}">
                                    <Label Text="{Binding Icono}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SubtituloCuenta}" Style="{StaticResource TextoSecundario}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding MontoTexto}" FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{Binding ColorMonto, Converter={StaticResource TextoAColor}}" />
                            </Grid>
                        </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
