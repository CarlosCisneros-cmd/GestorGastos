<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestorGastos.ViewModels"
             xmlns:m="clr-namespace:GestorGastos.Models"
             x:Class="GestorGastos.Views.vDeudaDetalle"
             x:DataType="vm:DeudaDetalleViewModel"
             Title="{Binding Titulo}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Eliminar" Command="{Binding EliminarCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Cuotas}" SelectionMode="None" Margin="18,8,18,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="10" Margin="0,0,0,10">
                <Border Style="{StaticResource TarjetaPrincipal}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Nombre}" TextColor="White" FontAttributes="Bold" FontSize="16" />
                        <Label Text="Saldo pendiente" TextColor="White" Opacity="0.85" FontSize="12" />
                        <Label Text="{Binding PendienteTexto}" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        <ProgressBar Progress="{Binding Progreso}" ProgressColor="White" Margin="0,4" />
                        <Label Text="{Binding ResumenTexto}" TextColor="White" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding Notas}" Style="{StaticResource TextoSecundario}" />
                <Label Text="Cuotas" Style="{StaticResource Subtitulo}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="m:CuotaItem">
                <Border Style="{StaticResource Tarjeta}" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding Icono}" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                            <Label Text="{Binding EstadoTexto}" FontSize="12" TextColor="{Binding ColorEstado, Converter={StaticResource TextoAColor}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                            <Label Text="{Binding MontoTexto}" FontAttributes="Bold" HorizontalOptions="End" />
                            <Button Text="Pagar" Style="{StaticResource BotonTexto}" FontSize="12" IsVisible="{Binding PuedePagar}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeudaDetalleViewModel}}, Path=PagarCuotaCommand}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.Footer>
            <BoxView HeightRequest="24" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
