<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestorGastos.ViewModels"
             xmlns:m="clr-namespace:GestorGastos.Models"
             x:Class="GestorGastos.Views.vDeudas"
             x:DataType="vm:DeudasViewModel"
             Title="{Binding Titulo}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nueva" Command="{Binding NuevaCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Deudas}" SelectionMode="None" Margin="18,8,18,0">
        <CollectionView.Header>
            <Border Style="{StaticResource TarjetaPrincipal}" Margin="0,0,0,10">
                <VerticalStackLayout>
                    <Label Text="Total pendiente de pago" TextColor="White" Opacity="0.85" FontSize="12" />
                    <Label Text="{Binding TotalPendienteTexto}" TextColor="White" FontSize="26" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </CollectionView.Header>
        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="20" Spacing="10">
                <Label Text="No tienes deudas registradas." Style="{StaticResource TextoSecundario}" FontSize="14" HorizontalOptions="Center" />
                <Button Text="Registrar deuda" Command="{Binding NuevaCommand}" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="m:DeudaResumen">
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconoCirculo}" BackgroundColor="{StaticResource AdvertenciaSuave}">
                                <Label Text="💳" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding CuotasTexto}" Style="{StaticResource TextoSecundario}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding PendienteTexto}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="{Binding Progreso}" ProgressColor="{StaticResource Ingreso}" />
                        <Label Text="{Binding ProximaCuotaTexto}" FontSize="12" TextColor="{Binding ColorEstado, Converter={StaticResource TextoAColor}}" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeudasViewModel}}, Path=AbrirCommand}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.Footer>
            <BoxView HeightRequest="24" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
