<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestorGastos.ViewModels"
             x:Class="GestorGastos.Views.vCuentaForm"
             x:DataType="vm:CuentaFormViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="18,12,18,24" Spacing="12">

            <Label Text="Nombre" Style="{StaticResource Etiqueta}" />
            <Border Style="{StaticResource Campo}">
                <Entry Text="{Binding Nombre}" Placeholder="Ej: Banco Pichincha" MaxLength="60" />
            </Border>

            <Label Text="Tipo de cuenta" Style="{StaticResource Etiqueta}" />
            <Border Style="{StaticResource Campo}">
                <Picker ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}" />
            </Border>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding EsNueva}">
                <Label Text="Saldo inicial" Style="{StaticResource Etiqueta}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding SaldoInicialTexto}" Placeholder="0,00" Keyboard="Numeric" />
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding EsEdicion}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Saldo actual" Style="{StaticResource TextoSecundario}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding SaldoActualTexto}" FontAttributes="Bold" FontSize="16" />
                </Grid>
            </Border>

            <Label Text="Moneda" Style="{StaticResource Etiqueta}" />
            <Border Style="{StaticResource Campo}">
                <Picker ItemsSource="{Binding Monedas}" SelectedItem="{Binding Moneda}" />
            </Border>

            <Label Text="Ícono" Style="{StaticResource Etiqueta}" />
            <CollectionView ItemsSource="{Binding Iconos}" SelectionMode="Single" SelectedItem="{Binding IconoSeleccionado}" HeightRequest="56">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Padding="2">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource PrimarioSuave}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding .}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" Padding="4" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Color" Style="{StaticResource Etiqueta}" />
            <CollectionView ItemsSource="{Binding Colores}" SelectionMode="Single" SelectedItem="{Binding ColorSeleccionado}" HeightRequest="52">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Padding="5">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource PrimarioSuave}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <BoxView Color="{Binding ., Converter={StaticResource TextoAColor}}" CornerRadius="16" WidthRequest="32" HeightRequest="32" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Guardar cuenta" Command="{Binding GuardarCommand}" Margin="0,8,0,0" />
            <Button Text="Eliminar cuenta" Style="{StaticResource BotonPeligro}" Command="{Binding EliminarCommand}" IsVisible="{Binding EsEdicion}" />
            <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
