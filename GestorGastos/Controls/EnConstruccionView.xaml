<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestorGastos.Controls.EnConstruccionView"
             x:Name="Raiz">
    <VerticalStackLayout Padding="32" Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
        <Label Text="🚧" FontSize="56" HorizontalOptions="Center" />
        <Label Text="{Binding Source={x:Reference Raiz}, Path=Descripcion}"
               Style="{StaticResource Titulo}" HorizontalTextAlignment="Center" />
        <Label Text="{Binding Source={x:Reference Raiz}, Path=Parte, StringFormat='Esta pantalla se desarrolla en la {0}.'}"
               Style="{StaticResource TextoSecundario}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
